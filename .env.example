# Copier en .env.local (jamais commité) puis remplir avec le bloc firebaseConfig de la console Firebase.
# Ces valeurs identifient le projet ; ce ne sont pas des secrets. La clé OpenRouter, elle, ne va JAMAIS ici :
# elle est enregistrée côté serveur avec `firebase functions:secrets:set OPENROUTER_API_KEY`.
VITE_DATA_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Nom de la base Firestore (console : Firestore → menu déroulant en haut). « boussole » pour le projet boussole-antonin.
VITE_FIREBASE_DATABASE_ID=boussole
# UID de ton compte Google dans Firebase (Authentication → Utilisateurs), après ta première connexion
VITE_OWNER_UID=
