# Copier en functions/.env (jamais commité). Ce ne sont pas des secrets : la clé OpenRouter, elle, passe par
#   npx firebase-tools functions:secrets:set OPENROUTER_API_KEY
# UID Firebase du propriétaire (Authentication → Utilisateurs). Contrôlé CÔTÉ SERVEUR à chaque appel.
OWNER_UID=
# Modèle OpenRouter (changer ici suffit, aucune modification du code)
AI_MODEL=google/gemma-4-31b-it:free
# Modèles de repli, séparés par des virgules, essayés dans l'ordre (vide = aucun)
AI_MODEL_FALLBACK=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Nom de la base Firestore
AI_DB_ID=boussole
# Plafonds d'appels
AI_LIMIT_PER_MIN=5
AI_LIMIT_PER_DAY=40
# true une fois App Check configuré côté appli (voir docs/firebase-setup.md)
AI_ENFORCE_APPCHECK=false
